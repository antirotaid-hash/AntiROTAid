<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      v15 public baseline: offline-only. The main manifest is clean by default:
      no INTERNET, no account/backend dependency, no notifications, no usage stats,
      no overlay, no foreground service. Course material, cards, plans, exam dates
      and progress stay in the app database on the learner's phone.

      The optional owner/internal focus-monitor components live only in the `full`
      flavor manifest, not in the Play/public baseline.
    -->

    <application
        android:name=".MindLiftApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindLift"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MindLift">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
