<Application x:Class="AntiROTAid.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Palette brushes are injected at runtime by AraTheme.Apply(). Shared,
             theme-independent shapes and styles live here. -->
        <CornerRadius x:Key="AraCardRadius">18</CornerRadius>

        <!-- Roboto = the Android/phone default typeface, embedded so the Windows app
             renders in the SAME font as the AAB (was Segoe UI). Applied to every text
             element via the implicit styles below. -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Assets/fonts/#Roboto</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>

        <!-- Primary gradient button (brand). -->
        <Style x:Key="AraPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0A0A0A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="16" Background="{DynamicResource AraBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined glass button. -->
        <Style x:Key="AraGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AraTitle}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                Background="{DynamicResource AraGlassGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon button used by every sub-page top bar (back "←" / help "?"). -->
        <Style x:Key="RoundIcon" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AraGreen}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="23" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                Background="{DynamicResource AraGlassGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark, theme-aware ComboBox so dropdowns match the dark-gold shell
             (the default WPF chrome renders light-gray and clashes). -->
        <Style x:Key="AraComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AraTitle}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AraGreenSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AraGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AraCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AraTitle}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AraComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="12" BorderThickness="1"
                                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                                Background="{DynamicResource AraGreenSoft}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 8 L 16 0" Stroke="{DynamicResource AraGreen}" StrokeThickness="2"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="14,0,38,0"
                                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border CornerRadius="12" Margin="0,4,0,0" BorderThickness="1"
                                        BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                        Background="{DynamicResource AraBgBottom}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark inner text field for the DatePicker so it blends with the shell
             (default DatePickerTextBox renders white). -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground" Value="{DynamicResource AraTitle}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AraTitle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="Transparent" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation button (toggle look driven by Tag='on'). -->
        <Style x:Key="AraNavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AraBody}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="12" Padding="14,11"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AraGreenSoft}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AraGlassEdgeGreen}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AraTitle}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AraGlassGradient}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
