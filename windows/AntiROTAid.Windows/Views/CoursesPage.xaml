<UserControl x:Class="AntiROTAid.Windows.Views.CoursesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RoundIcon" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AraGreen}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="23" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                Background="{DynamicResource AraGlassGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource RoundIcon}" Content="←" Click="Back_Click"/>
            <TextBlock x:Name="Title" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AraTitle}"/>
            <Button Grid.Column="2" Style="{StaticResource RoundIcon}" Content="?" Click="Help_Click"/>
        </Grid>

        <!-- Add course -->
        <Button x:Name="AddBtn" Grid.Row="1" Style="{StaticResource AraPrimaryBtn}" Height="58" Margin="0,18,0,0" Click="Add_Click"/>

        <!-- Inline add-from-text panel -->
        <Border x:Name="AddPanel" Grid.Row="2" Visibility="Collapsed" CornerRadius="16" Padding="16" Margin="0,12,0,0"
                Background="{DynamicResource AraGlassGradient}"
                BorderBrush="{DynamicResource AraGlassEdgeGreen}" BorderThickness="1">
            <StackPanel>
                <TextBox x:Name="NameBox" Height="40" FontSize="14" Padding="10,8"
                         Background="{DynamicResource AraGreenSoft}" Foreground="{DynamicResource AraTitle}"
                         CaretBrush="{DynamicResource AraTitle}" BorderBrush="{DynamicResource AraGlassEdgeGreen}"/>
                <Button x:Name="ImportBtn" Style="{StaticResource AraGhostBtn}" Height="46" Margin="0,10,0,0"
                        HorizontalContentAlignment="Center" Click="Import_Click"/>
                <TextBox x:Name="TextBox_" Height="110" Margin="0,10,0,0" FontSize="13" Padding="10,8"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource AraGreenSoft}" Foreground="{DynamicResource AraTitle}"
                         CaretBrush="{DynamicResource AraTitle}" BorderBrush="{DynamicResource AraGlassEdgeGreen}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CreateBtn" Style="{StaticResource AraPrimaryBtn}" Width="140" Height="42" Click="Create_Click"/>
                    <Button x:Name="CancelBtn" Style="{StaticResource AraGhostBtn}" Width="120" Height="42" Margin="10,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Library count -->
        <TextBlock x:Name="LibraryCount" Grid.Row="3" FontSize="13" Margin="2,16,0,0" Foreground="{DynamicResource AraMuted}"/>

        <!-- Sort row -->
        <StackPanel x:Name="SortRow" Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0"/>

        <!-- Course cards -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
    </Grid>
</UserControl>
