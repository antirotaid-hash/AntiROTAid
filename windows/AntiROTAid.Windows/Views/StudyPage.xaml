<UserControl x:Class="AntiROTAid.Windows.Views.StudyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RoundIcon" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AraGreen}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="23" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                Background="{DynamicResource AraGlassGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Outlined pill used by the Aa / Theme / ✕ toolbar. -->
        <Style x:Key="ToolPill" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="16" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}"
                                Background="{DynamicResource AraGlassGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: back · ARA logo + AntiROTAid + tagline · ? · counter -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource RoundIcon}" Content="←" Click="Back_Click"/>
            <Image Grid.Column="1" Source="/Assets/ara_wordmark.png" Height="30" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock>
                    <Run Text="AntiROTA" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AraTitle}"/><Run Text="id" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AraGreen}"/>
                </TextBlock>
                <TextBlock x:Name="Tagline" FontSize="12" Foreground="{DynamicResource AraMuted}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="HelpBtn" Grid.Column="3" Style="{StaticResource RoundIcon}" Content="?" Margin="6,0,10,0" Click="Help_Click"/>
            <TextBlock x:Name="Counter" Grid.Column="4" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource AraMuted}"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TextSizeBtn" Grid.Column="0" Style="{StaticResource ToolPill}" Click="TextSize_Click"/>
            <Button x:Name="ThemeBtn"    Grid.Column="2" Style="{StaticResource ToolPill}" Click="Theme_Click"/>
            <Button x:Name="RemoveBtn"   Grid.Column="4" Style="{StaticResource ToolPill}" Click="Remove_Click"/>
        </Grid>

        <!-- Progress bar -->
        <Border x:Name="ProgressTrack" Grid.Row="2" Height="6" CornerRadius="3" Margin="0,16,0,0" Background="{DynamicResource AraGreenSoft}">
            <Border x:Name="ProgressFill" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                    Background="{DynamicResource AraBrush}" Width="0"/>
        </Border>

        <!-- Empty state -->
        <TextBlock x:Name="Empty" Grid.Row="3" FontSize="15" Foreground="{DynamicResource AraMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Whole-course scrollable feed -->
        <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Margin="0,16,0,0" ScrollChanged="Scroller_ScrollChanged">
            <StackPanel x:Name="Feed"/>
        </ScrollViewer>
    </Grid>
</UserControl>
