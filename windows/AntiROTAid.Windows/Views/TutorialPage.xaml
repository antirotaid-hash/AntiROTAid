<UserControl x:Class="AntiROTAid.Windows.Views.TutorialPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title + Skip -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Title" Grid.Column="0" FontSize="20" FontWeight="Black" Foreground="{DynamicResource AraTitle}" VerticalAlignment="Center"/>
            <TextBlock x:Name="Skip" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AraMuted}"
                       VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Skip_Click"/>
        </Grid>

        <!-- Page body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel x:Name="Page" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Dots -->
        <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <!-- Back / Next -->
        <Grid Grid.Row="3" Margin="0,14,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackBtn" Grid.Column="0" Style="{StaticResource AraGhostBtn}" Height="52" Click="Back_Click"/>
            <Border x:Name="NextBtn" Grid.Column="2" CornerRadius="16" Background="{DynamicResource AraBrush}"
                    Cursor="Hand" MouseLeftButtonUp="Next_Click">
                <TextBlock x:Name="NextText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Black" FontSize="15" Foreground="#FF16110A"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
