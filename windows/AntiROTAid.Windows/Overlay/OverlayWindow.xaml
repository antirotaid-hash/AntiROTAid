<Window x:Class="AntiROTAid.Windows.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntiROTAid"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        SizeToContent="Height" Width="480"
        MouseLeftButtonDown="Card_MouseDown"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0A0A0A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="{DynamicResource AraBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AraMuted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" BorderThickness="1"
                                BorderBrush="{DynamicResource AraGlassEdgeGreen}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The glass card. Drop shadow gives the floating-over-everything feel. -->
    <Border x:Name="CardRoot" CornerRadius="20" Margin="18"
            Background="{DynamicResource AraGlassGradient}"
            BorderBrush="{DynamicResource AraGlassEdgeGreen}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">

            <!-- Brand row -->
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/ara_wordmark.png" Height="20" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderSuffix" FontSize="11" Margin="10,0,0,0"
                           Foreground="{DynamicResource AraMuted}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Motivational nag (rotates each appearance), like the phone overlay -->
            <Border x:Name="NagBanner" Visibility="Collapsed" CornerRadius="12" Margin="0,14,0,0"
                    Padding="12,8" Background="{DynamicResource AraGreenSoft}"
                    BorderBrush="{DynamicResource AraGlassEdgeGreen}" BorderThickness="1">
                <TextBlock x:Name="NagText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource AraGreenDeep}"/>
            </Border>

            <!-- Source label (e.g. Slide 3) -->
            <TextBlock x:Name="SourceLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AraTeal}" Margin="0,16,0,0"/>

            <!-- Concept title -->
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                       TextWrapping="Wrap" Foreground="{DynamicResource AraTitle}" Margin="0,4,0,0"/>

            <!-- Lesson body (scrollable if long): image/PDF card OR formatted text -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" Margin="0,14,0,0">
                <StackPanel x:Name="BodyHost"/>
            </ScrollViewer>

            <!-- Actions -->
            <Button x:Name="ContinueBtn" Style="{StaticResource PrimaryBtn}"
                    Margin="0,22,0,0" Click="Continue_Click"/>
            <Button x:Name="StopBtn" Style="{StaticResource GhostBtn}"
                    Margin="0,10,0,0" Click="Stop_Click"/>
        </StackPanel>
    </Border>
</Window>
