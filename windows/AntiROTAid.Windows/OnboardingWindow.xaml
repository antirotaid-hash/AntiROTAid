<Window x:Class="AntiROTAid.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntiROTAid"
        Width="460" Height="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FF16110A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{DynamicResource AraBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AraGreenSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AraMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" Background="{DynamicResource AraBgGradient}"
            BorderThickness="1" BorderBrush="{DynamicResource AraGlassEdgeGreen}">
        <Grid Margin="28,30,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Host"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Border x:Name="AgreeRow" Visibility="Collapsed" Margin="0,0,0,14"
                        CornerRadius="12" Padding="4" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="AgreeBox" Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource AraGreenSoft}"
                                BorderThickness="1" BorderBrush="{DynamicResource AraGlassEdgeGreen}">
                            <TextBlock x:Name="AgreeCheck" Text="✓" Visibility="Collapsed"
                                       Foreground="#FF16110A" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="AgreeLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AraBody}" FontSize="14"/>
                    </StackPanel>
                </Border>
                <Button x:Name="NextBtn" Style="{StaticResource PrimaryBtn}" Click="OnNext"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
