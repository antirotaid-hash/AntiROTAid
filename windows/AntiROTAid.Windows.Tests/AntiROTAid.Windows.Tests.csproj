<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the AntiROTAid Windows repair work. Targets the same windows TFM as
       the app so it can reference the app assembly (which exposes WPF-derived types). The
       tests themselves exercise only pure, engine-free logic: the study-progress state
       machine (ResumeMath), localization completeness (I18n), and the persisted models. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Match the app: drop the WinForms global usings that collide with WPF names. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiROTAid.Windows\AntiROTAid.Windows.csproj" />
  </ItemGroup>

</Project>
